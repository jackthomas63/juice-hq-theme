<section class="jhq-wrap" style="padding-top: clamp(64px, 7vw, 96px); padding-bottom: 56px;" aria-labelledby="hero-{{ section.id }}">
  {%- if section.settings.kicker != blank -%}
    <div class="jhq-hero__top"><span class="jhq-kicker">{{ section.settings.kicker }}</span></div>
  {%- endif -%}
  <h1 id="hero-{{ section.id }}" class="jhq-display">{{ section.settings.heading | newline_to_br }}</h1>
  {%- if section.settings.text != blank -%}
    <p class="jhq-lead jhq-hero__body">{{ section.settings.text }}</p>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Hero headline",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Small label", "default": "Raw cold-pressed juice · Bespoke branded beverages · Bespoke water" },
    { "type": "textarea", "id": "heading", "label": "Headline", "default": "The premier\nstandard.", "info": "Press return to start a new line." },
    { "type": "textarea", "id": "text", "label": "Intro", "default": "We make raw, cold-pressed juice in glass bottles for luxury hotels & hospitality, bespoke branded beverages that carry your brand at launches, stores and events and bespoke still & sparkling water for your venue or brand." }
  ],
  "presets": [{ "name": "Hero headline" }]
}
{% endschema %}
