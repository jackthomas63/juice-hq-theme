{%- assign per_view = section.settings.per_view | default: 2.5 -%}
{%- assign slide_w = 100.0 | divided_by: per_view | round: 3 -%}
<section class="jhq-wrap jhq-pad-s" aria-labelledby="carousel-{{ section.id }}" aria-roledescription="carousel">
  <jhq-carousel data-interval="{% if section.settings.autoplay %}{{ section.settings.interval | times: 1000 }}{% else %}0{% endif %}" style="--slide-w: {{ slide_w }}%; display: block;">
    <div class="jhq-head" style="margin-bottom: 40px;">
      <h2 id="carousel-{{ section.id }}" class="jhq-h2">{{ section.settings.heading }}</h2>
      <div class="jhq-carousel__controls">
        <span class="jhq-carousel__count" aria-live="polite"></span>
        <button type="button" class="jhq-arrow" data-prev aria-label="Previous project"><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M15 5l-7 7 7 7"/></svg></button>
        <button type="button" class="jhq-arrow jhq-arrow--next" data-next aria-label="Next project"><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9 5l7 7-7 7"/></svg></button>
        {%- if section.settings.link_label != blank -%}<a class="jhq-link" style="margin-left: 12px;" href="{{ section.settings.link | default: '/pages/work' }}">{{ section.settings.link_label }}</a>{%- endif -%}
      </div>
    </div>
    <ul class="jhq-carousel__track">
      {%- for block in section.blocks -%}
        <li class="jhq-carousel__slide" aria-roledescription="slide" aria-label="{{ forloop.index }} of {{ forloop.length }}: {{ block.settings.title | escape }}" {{ block.shopify_attributes }}>
          {%- render 'jhq-img', image: block.settings.image, fallback: block.settings.placeholder, alt: block.settings.title, class: 'jhq-card__img', sizes: '(min-width: 1000px) 40vw, 82vw' -%}
          <h3>{{ block.settings.title }}</h3>
        </li>
      {%- endfor -%}
    </ul>
    <div class="jhq-carousel__bar" aria-hidden="true"><span></span></div>
  </jhq-carousel>
</section>

{% schema %}
{
  "name": "Work carousel",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Selected work" },
    { "type": "text", "id": "link_label", "label": "Link text", "default": "View all work →" },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "range", "id": "per_view", "label": "Projects visible on desktop", "min": 2, "max": 3, "step": 0.5, "default": 2.5 },
    { "type": "checkbox", "id": "autoplay", "label": "Roll automatically", "default": true },
    { "type": "range", "id": "interval", "label": "Seconds per project", "min": 3, "max": 8, "step": 1, "unit": "s", "default": 4 }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Project",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "placeholder", "label": "Placeholder image (theme file)", "info": "Shown until you choose an image." },
        { "type": "text", "id": "title", "label": "Project name", "default": "Project" }
      ]
    }
  ],
  "presets": [{ "name": "Work carousel", "blocks": [{ "type": "slide" }, { "type": "slide" }, { "type": "slide" }] }]
}
{% endschema %}
