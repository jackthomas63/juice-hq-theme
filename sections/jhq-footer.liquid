<footer class="jhq-footer">
  <div class="jhq-wrap" style="padding-top: 96px; padding-bottom: 40px;">
    <div class="jhq-footer__top">
      <div class="jhq-footer__lead">
        {%- if section.settings.kicker != blank -%}<span class="jhq-kicker" style="color: #A6A6A6;">{{ section.settings.kicker }}</span>{%- endif -%}
        {%- if section.settings.heading != blank -%}<p>{{ section.settings.heading }}</p>{%- endif -%}
        {%- if section.settings.cta_label != blank -%}
          <a href="{{ section.settings.cta_link | default: '/pages/enquire' }}" class="jhq-link" style="font-size: 18px;">{{ section.settings.cta_label }}</a>
        {%- endif -%}
      </div>
      {%- for block in section.blocks -%}
        <div class="jhq-footer__col" {{ block.shopify_attributes }}>
          <span class="jhq-kicker" style="color: #A6A6A6; margin-bottom: 8px;">{{ block.settings.title }}</span>
          {%- for link in block.settings.menu.links -%}
            <a href="{{ link.url }}">{{ link.title }}</a>
          {%- endfor -%}
          {%- if block.settings.show_instagram and settings.instagram_url != blank -%}
            <a href="{{ settings.instagram_url }}" target="_blank" rel="noopener">Instagram</a>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
    {%- if settings.logo != blank -%}
      {{ settings.logo | image_url: width: 2800 | image_tag: class: 'jhq-footer__logo', alt: shop.name, loading: 'lazy', widths: '700, 1400, 2800', sizes: '100vw' }}
    {%- else -%}
      <img class="jhq-footer__logo" src="{{ 'juice-hq-logo.png' | asset_url }}" alt="{{ shop.name | escape }}" width="2327" height="607" loading="lazy">
    {%- endif -%}
    <div class="jhq-footer__base">
      <span>&copy; {{ 'now' | date: '%Y' }} {{ section.settings.copyright }}</span>
      <span>
        {%- for link in section.settings.legal_menu.links -%}
          <a href="{{ link.url }}">{{ link.title }}</a>{% unless forloop.last %} · {% endunless %}
        {%- endfor -%}
      </span>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Small label", "default": "Enquiries" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Tell us about your venue, launch or event." },
    { "type": "text", "id": "cta_label", "label": "Link text", "default": "Start an enquiry →" },
    { "type": "url", "id": "cta_link", "label": "Link" },
    { "type": "text", "id": "copyright", "label": "Copyright line", "default": "Juice HQ. A family business." },
    { "type": "link_list", "id": "legal_menu", "label": "Legal links menu", "info": "e.g. Privacy, Terms" }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Link column",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "title", "label": "Column title", "default": "Juice HQ" },
        { "type": "link_list", "id": "menu", "label": "Menu" },
        { "type": "checkbox", "id": "show_instagram", "label": "Add Instagram link", "default": false }
      ]
    }
  ]
}
{% endschema %}
