<section class="jhq-wrap" aria-label="{{ section.settings.kicker | escape }}">
  <jhq-film style="display: block;">
    <div class="jhq-film">
      {%- if section.settings.video != blank -%}
        {{ section.settings.video | video_tag: image_size: '2000x', playsinline: true, preload: 'none' }}
      {%- elsif section.settings.video_file != blank -%}
        <video class="jhq-film__bg" src="{{ section.settings.video_file | asset_url }}" autoplay muted loop playsinline preload="metadata" aria-label="{{ section.settings.kicker | escape }}"></video>
      {%- elsif section.settings.video_url != blank -%}
        <template>
          {%- if section.settings.video_url.type == 'youtube' -%}
            <iframe src="https://www.youtube.com/embed/{{ section.settings.video_url.id }}?autoplay=1&rel=0" title="{{ section.settings.kicker | escape }}" allow="autoplay; encrypted-media; fullscreen" allowfullscreen style="position: absolute; inset: 0; width: 100%; height: 100%; border: 0;"></iframe>
          {%- else -%}
            <iframe src="https://player.vimeo.com/video/{{ section.settings.video_url.id }}?autoplay=1" title="{{ section.settings.kicker | escape }}" allow="autoplay; fullscreen" allowfullscreen style="position: absolute; inset: 0; width: 100%; height: 100%; border: 0;"></iframe>
          {%- endif -%}
        </template>
      {%- endif -%}
      {%- if section.settings.video_file == blank or section.settings.video != blank -%}
        {%- render 'jhq-img', image: section.settings.poster, fallback: 'jhq-corner-shop-2.jpg', alt: '', class: 'jhq-film__poster', sizes: '100vw' -%}
      {%- endif -%}
      <div class="jhq-film__overlay">
        <span class="jhq-kicker" style="color: #fff;">{{ section.settings.kicker }}</span>
        <div style="display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: 24px;">
          <span class="jhq-serif" style="font-size: clamp(36px, 5vw, 80px); line-height: 1;">{{ section.settings.title }}</span>
          <button type="button" class="jhq-film__play" data-play aria-label="Play {{ section.settings.kicker | escape }}"><svg aria-hidden="true" width="26" height="26" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg></button>
        </div>
      </div>
    </div>
  </jhq-film>
</section>

{% schema %}
{
  "name": "Brand film",
  "settings": [
    { "type": "video", "id": "video", "label": "Video (uploaded to Shopify)" },
    { "type": "video_url", "id": "video_url", "label": "Or a YouTube / Vimeo link", "accept": ["youtube", "vimeo"] },
    { "type": "text", "id": "video_file", "label": "Video file in the theme", "info": "Plays silently in the background; the play button restarts it with sound." },
    { "type": "image_picker", "id": "poster", "label": "Cover image" },
    { "type": "text", "id": "kicker", "label": "Label", "default": "The Juice HQ brand film" },
    { "type": "text", "id": "title", "label": "Title", "default": "The premier standard." }
  ],
  "presets": [{ "name": "Brand film" }]
}
{% endschema %}
