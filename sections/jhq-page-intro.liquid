<section class="jhq-wrap" style="padding-top: clamp(64px, 7vw, 96px); padding-bottom: clamp(56px, 7vw, 96px);" aria-labelledby="intro-{{ section.id }}">
  {%- if section.settings.kicker != blank -%}<span class="jhq-kicker" style="margin-bottom: 40px;">{{ section.settings.kicker }}</span>{%- endif -%}
  <div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 32px 64px;">
    <h1 id="intro-{{ section.id }}" class="jhq-h1{% if section.settings.serif %} jhq-serif{% endif %}" style="max-width: 1200px;">{{ section.settings.heading | default: page.title }}</h1>
    {%- if section.settings.text != blank -%}<p style="font-size: clamp(19px, 1.7vw, 24px); line-height: 1.4; font-weight: 300; max-width: 560px;">{{ section.settings.text }}</p>{%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Page heading",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Small label" },
    { "type": "text", "id": "heading", "label": "Heading", "info": "Leave blank to use the page title." },
    { "type": "checkbox", "id": "serif", "label": "Use italic serif", "default": false },
    { "type": "textarea", "id": "text", "label": "Intro text" }
  ],
  "presets": [{ "name": "Page heading" }]
}
{% endschema %}
