<section class="jhq-dark" aria-labelledby="process-{{ section.id }}">
  <div class="jhq-wrap jhq-pad">
    <div style="display: flex; flex-wrap: wrap; justify-content: space-between; gap: 40px; align-items: flex-end; margin-bottom: {% if section.blocks.size > 0 %}80px{% else %}0{% endif %};">
      <div style="display: flex; flex-direction: column; gap: 24px; max-width: 820px;">
        {%- if section.settings.kicker != blank -%}<span class="jhq-kicker">{{ section.settings.kicker }}</span>{%- endif -%}
        <h2 id="process-{{ section.id }}" class="jhq-h2-xl">{{ section.settings.heading | newline_to_br }}</h2>
        {%- if section.settings.text != blank -%}<p class="jhq-body" style="font-size: 19px; max-width: 620px;">{{ section.settings.text }}</p>{%- endif -%}
      </div>
      {%- if section.settings.button_label != blank -%}<a class="jhq-btn" href="{{ section.settings.button_link | default: '/pages/enquire' }}">{{ section.settings.button_label }}</a>{%- endif -%}
    </div>
    {%- if section.blocks.size > 0 -%}
      <ol class="jhq-steps">
        {%- for block in section.blocks -%}
          <li {{ block.shopify_attributes }}>
            <span class="jhq-num" style="color: #8C8C8C;">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
            <strong>{{ block.settings.title }}</strong>
            <span class="jhq-small">{{ block.settings.text }}</span>
          </li>
        {%- endfor -%}
      </ol>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Black band",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Small label", "default": "How we work" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "Your package, built with you." },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "text", "id": "button_label", "label": "Button text", "default": "Start an enquiry" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "limit": 6,
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Step" },
        { "type": "textarea", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [{ "name": "Black band" }]
}
{% endschema %}
