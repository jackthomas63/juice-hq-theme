<section class="jhq-dark">
  <figure class="jhq-wrap jhq-pad" style="display: flex; flex-direction: column; gap: 32px;">
    <blockquote class="jhq-serif" style="font-size: clamp(36px, 4.8vw, 76px); line-height: 1.05; max-width: 1100px;">“{{ section.settings.quote }}”</blockquote>
    {%- if section.settings.attribution != blank -%}<figcaption class="jhq-kicker">{{ section.settings.attribution }}</figcaption>{%- endif -%}
  </figure>
</section>

{% schema %}
{
  "name": "Quote",
  "settings": [
    { "type": "textarea", "id": "quote", "label": "Quote", "default": "A line from Katie or Scott, in their own words." },
    { "type": "text", "id": "attribution", "label": "Name" }
  ],
  "presets": [{ "name": "Quote" }]
}
{% endschema %}
