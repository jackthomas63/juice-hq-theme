{% style %}
  :root {
    --jhq-ink: {{ settings.foreground_color }};
    --jhq-paper: {{ settings.background_color }};
    --jhq-stone: {{ settings.stone_color }};
    --jhq-muted: #6B6B6B;
    --jhq-body: #3A3A3A;
    --jhq-line: #E6E6E6;
    --jhq-sans: 'Inter Tight', system-ui, -apple-system, sans-serif;
    --jhq-serif: 'Instrument Serif', Georgia, serif;
    --jhq-max: 1440px;
    --jhq-gutter: clamp(20px, 3.4vw, 48px);
    --style-border-radius-inputs: 0px;
    --color-background: {{ settings.background_color }};
    --color-foreground: {{ settings.foreground_color }};
    --font-primary--family: var(--jhq-sans);
    --page-width: var(--jhq-max);
    --page-margin: var(--jhq-gutter);
  }
{% endstyle %}
